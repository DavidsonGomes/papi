# Storage Type: file | postgres | postgres+redis
# - file: Store sessions on disk (default, good for small deployments)
# - postgres: Store sessions in PostgreSQL (better for scaling)
# - postgres+redis: PostgreSQL + Redis cache (best performance)
STORAGE_TYPE=file

# PostgreSQL Configuration (required if STORAGE_TYPE is postgres or postgres+redis)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pastorini_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_SSL=false

# Redis Configuration (required if STORAGE_TYPE is postgres+redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WhatsApp Version Override (optional)
# CONFIG_SESSION_PHONE_VERSION=2.24.6.77

# Server Port
PORT=3000

# Panel API Key (optional - leave empty to disable panel protection)
# If set, users need this key to access the web panel
PANEL_API_KEY=



# ═══════════════════════════════════════════════════════════════
# LICENSE SYSTEM (optional - leave empty for development mode)
# ═══════════════════════════════════════════════════════════════

# License key provided by admin
LICENSE_KEY=

# Admin server URL for license verification
LICENSE_ADMIN_URL=
